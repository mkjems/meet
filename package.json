{
  "name": "meet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Meet: video calls for up to four people in the browser, browser to browser. See docs/Plan.md.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "browser": "node tests/browser.mjs",
    "serve": "npm run build && node server/server.mjs"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "playwright": "^1.65.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  }
}
